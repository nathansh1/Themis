SEPOLIA_RPC_URL=
ZERODEV_PROJECT_ID=
ZERODEV_BUNDLER_RPC=
VENICE_API_KEY=
VENICE_BASE_URL=

# Dev Wallet Only
DEV_OWNER_PRIVATE_KEY=
SESSION_PRIVATE_KEY=

KERNEL_ADDRESS=
AAVE_POOL_ADDRESS=
USDC_ADDRESS=
WETH_ADDRESS=

# Local Themis API (optional; account defaults to local A1 proof)
KERNEL_ACCOUNT_ADDRESS=
THEMIS_PORT=3001
# Distinct bearer tokens; generated under packages/themis/.local/ when blank
THEMIS_AGENT_TOKEN=
THEMIS_OWNER_TOKEN=


# Agent (packages/agent)
# AGENT_MODE=hermes runs the real Hermes Agent (default); direct is the plain-Venice fallback.
# VENICE_MODEL must support tool calling on Venice (hermes-3-llama-3.1-405b does not). Default: llama-3.3-70b.
# THEMIS_URL switches agent AND web app between the built-in stand-in and the real server:
#   unset                  -> stand-in inside the web app (http://localhost:3000/api)
#   http://127.0.0.1:3001  -> the real Themis server (packages/themis, `node server.mjs`)
# API tokens are read from packages/themis/.local/api-credentials.json, or THEMIS_AGENT_TOKEN / THEMIS_OWNER_TOKEN.
# THEMIS_RULESET_ROLE=owner makes propose_ruleset use the owner token (Themis currently only allows that).
AGENT_MODE=hermes
VENICE_MODEL=
THEMIS_URL=
HEALTH_THRESHOLD=1.15
POLL_MS=5000
COOLDOWN_MS=60000
